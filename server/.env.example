# Server port
PORT=3000

# CORS allowed origins (comma-separated)
# Example: https://yourgame.com,https://www.yourgame.com
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Node environment: development | production
NODE_ENV=development

# Database path (defaults to ./data/tower_defense.db)
# DB_PATH=/data/tower_defense.db

# Toss Payments (https://developers.tosspayments.com)
# Leave empty for test mode (auto-approve all payments)
# TOSS_SECRET_KEY=test_sk_xxxxxxxx
# TOSS_CLIENT_KEY=test_ck_xxxxxxxx
